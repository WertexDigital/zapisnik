{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zápisník",
  "version": "2.0.1",
  "identifier": "cz.zapisnik.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zápisník",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Jednoduchý sešit na poznámky",
    "copyright": "© 2026 WertexDigital",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Czech",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5OUY3NjBEQUEzQkFGNkIKUldScnJ6dXFEWGFmcVJ3L1E0aEhiNTUxamNyYjR6V0Nqd3hQSnFRYVlueFpndjkxbG1IbXoraUIK",
      "endpoints": [
        "https://github.com/WertexDigital/zapisnik/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
